VITE_API_BASE_URL=https://6q48e144hf.execute-api.us-east-1.amazonaws.com
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_Bk34M28uI
VITE_COGNITO_CLIENT_ID=2tv6pqcq4408f4oqmloacetf1f

# The VAPID public key. Not secret -- it ships in the browser bundle -- but it
# must stay byte-identical to the VapidPublicKey stack parameter and to the
# private half in SSM at /perfectpick/vapid-private-key. A mismatch is not a
# deploy error: subscriptions are simply signed against a key the push service
# rejects, and nothing is ever delivered.
#
# An absent value is worse than a wrong one, because it makes the Notify
# control vanish from the deployed app with nothing to say why -- so
# check-auth-env.js warns (without blocking) if this is missing.
VITE_VAPID_PUBLIC_KEY=BPzgB3Ku2gUMoT5LJxRW8X_vvjim8tbLrZFh_xYLM7AvtMgQzEUiazfPd0-6FgUQCXnyBQKe5JNSk25VbGu9LzQ
